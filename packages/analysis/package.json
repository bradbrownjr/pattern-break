{
  "name": "@game/analysis",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "libopenmpt WASM wrapper: load module, offline render pass, pattern data extraction -> LevelData.",
  "exports": {
    ".": "./src/index.ts",
    "./libopenmpt.wasm": "./vendor/libopenmpt/libopenmpt.wasm",
    "./fixtures/*": "./fixtures/*"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "test": "vitest run --project node",
    "analyze": "node scripts/analyze.ts",
    "bench:sim": "node scripts/bench-sim.ts",
    "bench:sim:max": "node scripts/bench-sim-max.ts",
    "test:browser": "vitest run --project browser"
  },
  "dependencies": {
    "@game/core": "workspace:*"
  },
  "devDependencies": {
    "@vitest/browser-playwright": "5.1.0",
    "playwright": "1.65.0"
  }
}
