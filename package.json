{
  "name": "pattern-break",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "lint": "oxlint",
    "typecheck": "pnpm -r --if-present typecheck && tsc -p tools/tsconfig.json",
    "test": "pnpm -r --if-present test",
    "check:docs": "node tools/check-docs.ts",
    "gen:tables": "node tools/gen-spectrum-tables.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm check:docs && pnpm check:music",
    "dev": "pnpm --filter @game/client dev",
    "serve": "pnpm --filter @game/server start",
    "build": "pnpm -r --if-present build",
    "screenshots": "node tools/screenshots/capture.ts",
    "record:replay": "node tools/record-replay.ts",
    "test:browser": "pnpm --filter @game/analysis --filter @game/client test:browser",
    "check:music": "node tools/validate-manifest.ts",
    "check:offline": "node tools/offline-check.ts",
    "check:difficulty": "node tools/difficulty-report.ts --check"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "gifenc": "1.0.3",
    "oxlint": "^1.92.0",
    "playwright": "1.65.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
